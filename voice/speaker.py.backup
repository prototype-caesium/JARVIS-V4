import subprocess


class VoiceInfo:
    name = "eSpeak NG (en-us)"


VOICE = VoiceInfo()


def speak(text):
    print(f"JARVIS: {text}")

    piper = subprocess.Popen(
        [
            "espeak-ng",
            "-v", "en-us",
            "-s", "175",
            "--stdout",
        ],
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
    )

    aplay = subprocess.Popen(
        ["aplay", "-q"],
        stdin=piper.stdout,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )

    piper.stdin.write((text + "\n").encode())
    piper.stdin.close()

    aplay.wait()
    piper.wait()
