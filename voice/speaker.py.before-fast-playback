import subprocess


VOICE = "en-us+m4"
SPEED = "165"
PITCH = "52"
AMPLITUDE = "135"
WORD_GAP = "2"


class VoiceInfo:
    name = "eSpeak NG Natural Male"


VOICE_INFO = VoiceInfo()


def speak(text):
    text = str(text).strip()
    text = text.replace("JARVIS", "Jar-vis").replace("Jarvis", "Jar-vis")

    if not text:
        return

    print(f"JARVIS: {text}")

    subprocess.run(
        [
            "espeak-ng",
            "-v", VOICE,
            "-s", SPEED,
            "-p", PITCH,
            "-a", AMPLITUDE,
            "-g", WORD_GAP,
            text,
        ],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
